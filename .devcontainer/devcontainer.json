{
  "name": "Flutter Dev Environment",
  "image": "ghcr.io/cirruslabs/flutter:3.44.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "postCreateCommand": "flutter doctor && npm install -g wrangler"
}